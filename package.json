{
	"name": "urisdae",
	"version": "1.0.0",
	"description": "A collection of bearish tools.",
	"main": "index.js",
	"scripts": {
		"lint": "eslint src --ext .ts",
		"lint:fix": "eslint src --ext .ts --fix",
		"format": "prettier --write src",
		"format:check": "prettier --check src",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:coverage": "vitest --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthony-safford/Ursidae.git"
	},
	"keywords": [],
	"type": "module",
	"bugs": {
		"url": "https://github.com/anthony-safford/Ursidae/issues"
	},
	"homepage": "https://github.com/anthony-safford/Ursidae#readme",
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.3.3",
		"eslint-plugin-tsdoc": "^0.5.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,mts,mjs}": [
			"prettier --write"
		]
	}
}
