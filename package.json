{
	"name": "urisdae",
	"version": "1.0.0",
	"description": "A collection of bearish tools.",
	"main": "index.js",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint src --ext .ts,.tsx",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"format": "prettier --write src",
		"format:check": "prettier --check src",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:coverage": "vitest --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anthony-safford/Ursidae.git"
	},
	"keywords": [],
	"type": "module",
	"bugs": {
		"url": "https://github.com/anthony-safford/Ursidae/issues"
	},
	"homepage": "https://github.com/anthony-safford/Ursidae#readme",
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"wouter": "^3.2.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"@vitejs/plugin-react": "^4.3.0",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsdoc": "^63.3.3",
		"eslint-plugin-tsdoc": "^0.5.2",
		"globals": "^17.9.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^5.4.0",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,mts,mjs}": [
			"prettier --write"
		]
	}
}
