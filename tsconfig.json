{
	"compilerOptions": {
		"target": "ES2020",
		"module": "esnext",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "bundler",
		"types": ["vite/client", "vitest/globals"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
