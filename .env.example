# Port for the Vite frontend dev server
FRONTEND_PORT=5173

# Port for the local Fastify backend (added in feature #22)
BACKEND_PORT=3000

# Directory where per-tool SQLite database files are stored (added in feature #25)
DATA_DIR=./data

# Directory where log files are written (added in feature #24)
LOG_DIR=./logs

# Minimum log level: fatal, error, warn, info, debug, or trace (added in feature #24)
LOG_LEVEL=info
